# Streaming desktop: shell-ninja-inspired palette, compact gaps, readable UI.
# Local adaptation; the upstream installer is deliberately not executed.
# Alt is the primary modifier for browser-hosted remote desktops.
set $mod Mod1
set $ws1 "1:term"
set $ws2 "2:web"
set $ws3 "3:files"
set $ws4 "4:misc"
set $main $ws1
font pango:JetBrains Mono 10
floating_modifier $mod
focus_follows_mouse no
mouse_warping none
focus_wrapping yes
# Selecting the current workspace must not jump to the previous one.
workspace_auto_back_and_forth no
force_display_urgency_hint 0 ms
default_orientation horizontal
# Extra windows are tabs, never a row of unusably narrow columns.
workspace_layout tabbed
default_border normal 2
default_floating_border normal 2
hide_edge_borders none
title_align left
show_marks no
gaps inner 8
gaps outer 0
smart_gaps off

#                    border  background text    indicator child_border
client.focused          #88c0d0 #273b50 #eceff4 #88c0d0 #88c0d0
client.focused_inactive #30455c #172331 #a8bdd2 #30455c #30455c
client.unfocused        #263649 #101923 #a8bdd2 #263649 #263649
client.urgent           #bf616a #bf616a #ffffff #bf616a #bf616a
client.background #101923

# Keep terminals and browsers on separate, tabbed workspaces.
assign [class="(?i)^(qterminal|xfce4-terminal|xterm|uxterm|alacritty|kitty|gnome-terminal|konsole)$"] $ws1
assign [class="(?i)^firefox(-esr)?$"] $ws2
assign [class="(?i)^(google-chrome|google-chrome-unstable|chromium|chromium-browser|brave-browser)$"] $ws2
# File managers, archive tools, editors, and document/image viewers belong in Files.
set $fileapps thunar|nautilus|org[.]gnome[.]nautilus|nemo|caja|pcmanfm(-qt)?|dolphin|org[.]kde[.]dolphin|doublecmd|spacefm|xarchiver|file-roller|org[.]gnome[.]fileroller|engrampa|ark|org[.]kde[.]ark|peazip|7zfm|geany|vscodium|codium|codeium|windsurf|code|code-oss|mousepad|com[.]visualstudio[.]codeoss|gedit|org[.]gnome[.]gedit|org[.]gnome[.]texteditor|xed|leafpad|kate|kwrite|evince|org[.]gnome[.]evince|atril|okular|org[.]kde[.]okular|xreader|zathura|mupdf|eog|org[.]gnome[.]eog|eom|ristretto|viewnior|gwenview|org[.]kde[.]gwenview|libreoffice.*|soffice
assign [class="(?i)^($fileapps)$"] $ws3
# Files workspace: editors in a 60% tabbed pane, Thunar in a 40% pane.
# The helper initializes the split once and preserves subsequent manual resizing.
for_window [window_type="normal" class="(?i)^(thunar|geany|vscodium|codium|codeium|windsurf|code|code-oss|mousepad|com[.]visualstudio[.]codeoss)$"] exec --no-startup-id @HOME@/.local/bin/i3-stream-layout --ensure
# Everything else (Burp, Ghidra, etc.) goes to misc.
# Exclude assigned classes so the rules do not overlap.
assign [window_type="normal" class="(?i)^(?!(qterminal|xfce4-terminal|xterm|uxterm|alacritty|kitty|gnome-terminal|konsole|firefox(-esr)?|google-chrome|google-chrome-unstable|chromium|chromium-browser|brave-browser|$fileapps)$).*"] $ws4
# Persistent top drop-down terminal; floating windows are ignored by the layout watchdog.
for_window [instance="^i3-dropdown$"] floating enable, border pixel 2, move scratchpad, scratchpad show, resize set width 90 ppt height 45 ppt, move position 5 ppt 45 px, sticky enable
for_window [window_type="dialog"] floating enable, resize set 800 600, move position center
for_window [window_role="pop-up"] floating enable, resize set 800 600, move position center
for_window [class="xdg-desktop-portal-gtk"] floating enable, resize set 800 600, move position center
for_window [class="(?i)^pavucontrol$"] floating enable, resize set 700 500, move position center
for_window [class="(?i)^nm-connection-editor$"] floating enable, resize set 700 500, move position center
for_window [class="(?i)^xfce4-settings-manager$"] floating enable, resize set 800 600, move position center
for_window [class="(?i)^google-chrome$" window_type="dialog"] floating enable, resize set 800 600, move position center
for_window [title="^(Open File|Save File|Open Folder|Select a File|Select Folder)$"] floating enable, resize set 800 600, move position center
for_window [window_type="dialog"] focus
for_window [class="(?i)^qterminal$"] title_format "Terminal | %title"
for_window [class="^Google-chrome$"] title_format "Chrome Harness | %title"

# Keyboard plus mouse launchers in the top bar. Alt alternatives work over streams.
bindsym $mod+Return exec --no-startup-id @HOME@/.local/bin/open-terminal
bindsym $mod+grave exec --no-startup-id @HOME@/.local/bin/toggle-dropdown-terminal
bindsym Mod4+grave exec --no-startup-id @HOME@/.local/bin/toggle-dropdown-terminal
bindsym $mod+b exec --no-startup-id @HOME@/.local/bin/open-browser --new-window
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+e exec --no-startup-id @HOME@/.local/bin/open-files
bindsym Mod4+Shift+e exec --no-startup-id @HOME@/.local/bin/open-files
bindsym $mod+Tab exec rofi -show window
bindsym Mod1+F1 exec rofi -show drun
bindsym Mod1+F2 exec rofi -show run
bindsym --release Control+Mod1+t exec --no-startup-id @HOME@/.local/bin/open-terminal
bindsym --release Control+Mod1+b exec --no-startup-id @HOME@/.local/bin/open-browser --new-window
bindsym $mod+Shift+q kill
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+e layout toggle split
bindsym $mod+w layout tabbed
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4

# Super (Mod4) workspace switching fallback
bindsym Mod4+1 workspace $ws1
bindsym Mod4+2 workspace $ws2
bindsym Mod4+3 workspace $ws3
bindsym Mod4+4 workspace $ws4
bindsym Mod4+Shift+1 move container to workspace $ws1
bindsym Mod4+Shift+2 move container to workspace $ws2
bindsym Mod4+Shift+3 move container to workspace $ws3
bindsym Mod4+Shift+4 move container to workspace $ws4
bindsym Mod4+Return exec --no-startup-id @HOME@/.local/bin/open-terminal
bindsym Mod4+b exec @HOME@/.local/bin/open-browser
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Ctrl+Left resize shrink width 5 ppt
bindsym $mod+Ctrl+Right resize grow width 5 ppt
# Drag a tiled split boundary with Mod+right mouse button to resize it.
bindsym $mod+button3 resize
bindsym $mod+Shift+BackSpace exec @HOME@/.local/bin/i3-stream-layout --reset

# Volume and media keys
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

exec_always --no-startup-id @HOME@/.local/bin/i3-stream-start
exec --no-startup-id @HOME@/.local/bin/i3-keep-apps
